# Copia a .env (Docker, raíz) o a backend/.env (arranque manual) y ajusta. Nunca subas el .env real.

# --- Base de datos y API ---
DB_PATH=
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
SCHEDULER_ENABLED=true

# --- Noticias y Web Push (opcionales) ---
NEWSAPI_KEY=
VAPID_EMAIL=mailto:admin@finance-portfolio.local

# --- Proveedor de IA: lmstudio | ollama | openai_compatible | anthropic ---
LLM_PROVIDER=ollama

# Ollama (local, recomendado; no necesita API key)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# LM Studio (local)
LM_STUDIO_URL=http://localhost:1234
LM_STUDIO_MODEL=local-model

# Endpoint compatible con OpenAI (OpenAI, OpenRouter, Groq, vLLM...)
OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=gpt-4o-mini

# Anthropic (nube, opcional)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api
