# Database (SQLite by default)
DB_PATH=./finance_portfolio.db

# News API (optional — falls back to yfinance news)
NEWSAPI_KEY=

# VAPID keys for Web Push (generate with: python -c "from services.alerts import generate_vapid_keys; generate_vapid_keys()")
VAPID_EMAIL=mailto:your@email.com

# Scheduler (disable for dev)
SCHEDULER_ENABLED=true

# API server
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# --- AI provider (company analysis) ---
# One of: lmstudio | ollama | openai_compatible | anthropic
LLM_PROVIDER=ollama
LM_STUDIO_URL=http://localhost:1234
LM_STUDIO_MODEL=local-model
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Only needed if LLM_PROVIDER=openai_compatible. Works with OpenAI, OpenRouter,
# Groq, Together, vLLM, LocalAI — anything that speaks the OpenAI chat API.
OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=gpt-4o-mini
# Only needed if LLM_PROVIDER=anthropic. Cloud, paid — get a key at
# https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
